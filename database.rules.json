{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "sessions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$sid": {
        "pub": {
          ".read": "auth != null"
        },
        "keys": {
          "$key": {
            ".read": "auth != null"
          }
        },
        "votes": {
          "$id": {
            ".write": "auth != null && !data.exists() && root.child('sessions').child($sid).child('pub/status').val() === 'open' && newData.child('key').isString() && root.child('sessions').child($sid).child('keys').child(newData.child('key').val()).child('id').val() === $id",
            ".validate": "newData.hasChildren(['first', 'second', 'key', 'at']) && newData.child('first').isString() && newData.child('first').val().length <= 4 && newData.child('second').isString() && newData.child('second').val().length <= 4 && newData.child('at').isNumber()",
            "$other": {
              ".validate": "$other === 'first' || $other === 'second' || $other === 'key' || $other === 'at'"
            }
          }
        }
      }
    }
  }
}
